# Template only: replace every REPLACE_WITH value before starting services.
server:
  hostname: 127.0.0.1
  port: 2002
  trustProxy:
  - loopback
  clusters: null
metrics:
  hostname: 127.0.0.1
  basePort: 2020
  allowedIps: []
services:
  database:
    type: mariadb
    host: 127.0.0.1
    port: 13306
    username: libreoj
    password: REPLACE_WITH_DATABASE_PASSWORD
    database: libreoj
  minio:
    default:
      endpoint: http://127.0.0.1:19000
      urlEndpoint: null
    forUserUpload:
      endpoint: http://127.0.0.1:19000
      urlEndpoint: http://localhost/storage/
    forUserDownload:
      endpoint: http://127.0.0.1:19000
      urlEndpoint: http://localhost/storage/
    forJudge:
      endpoint: http://127.0.0.1:19000
      urlEndpoint: http://localhost/storage/
    accessKey: REPLACE_WITH_MINIO_ACCESS_KEY
    secretKey: REPLACE_WITH_MINIO_SECRET_KEY
    bucket: libreoj-files
  redis: redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:16379/0
  mail:
    address: no-reply@libreoj.test
    transport: smtp://username:password@smtp.libreoj.test:25
security:
  crossOrigin:
    enabled: false
    whiteList: []
  sessionSecret: REPLACE_WITH_SESSION_SECRET
  maintainceKey: REPLACE_WITH_MAINTENANCE_KEY
  proofOfWork:
    difficulty: 4
    expensiveActionDifficulty: 5
  captcha:
    turnstile: null
    tencentCaptcha: null
  rateLimit:
    maxRequests: 200
    durationSeconds: 10
preference:
  siteName: LLMOJ
  copyrightNotice: LibreOJ Open Source Project
  security:
    requireEmailVerification: true
    allowUserChangeUsername: true
    allowEveryoneCreateProblem: true
    allowNonPrivilegedUserEditPublicProblem: true
    allowOwnerManageProblemPermission: false
    allowOwnerDeleteProblem: true
    allowEveryoneCreateDiscussion: true
    discussionDefaultPublic: true
    discussionReplyDefaultPublic: true
  pagination:
    homepageUserList: 10
    homepageProblemList: 10
    problemSet: 50
    searchProblemsPreview: 7
    submissions: 10
    submissionStatistics: 10
    userList: 30
    userAuditLogs: 10
    discussions: 10
    searchDiscussionsPreview: 7
    discussionReplies: 40
    discussionRepliesHead: 20
    discussionRepliesMore: 20
  misc:
    appLogo: ''
    appLogoForTheme:
      pure: original
      far: inverted
    googleAnalyticsId: null
    plausibleApiEndpoint: null
    gravatarCdn: https://gravatar.com
    redirectLegacyUrls: false
    legacyContestsEntryUrl: null
    homepageUserListOnMainView: true
    sortUserByRating: false
    renderMarkdownInUserBio: false
    discussionReactionEmojis:
    - 👍
    - 👎
    - 😄
    - 😕
    - ❤️
    - 🤔
    - 🤣
    - 🌿
    - 🍋
    - 🕊️
    discussionReactionAllowCustomEmojis: true
  serverSideOnly:
    discussionReactionCustomEmojisBlacklist: /(\uD83C[\uDDE6-\uDDFF]){2}/
    dynamicTaskPriority: true
resourceLimit:
  problemTestdataFiles: 2005
  problemTestdataSize: 8589934592
  problemAdditionalFileFiles: 40
  problemAdditionalFileSize: 134217728
  problemSamplesToRun: 10
  problemTestcases: 1000
  problemTimeLimit: 2000
  problemMemoryLimit: 512
  submissionFileSize: 10485760
queryLimit:
  problemSet: 100
  submissions: 10
  submissionStatistics: 10
  searchUser: 10
  searchGroup: 10
  userList: 100
  userAuditLogs: 20
  discussions: 20
  discussionReplies: 50
judge:
  limit:
    compilerMessage: 524288
    outputSize: 104857600
    dataDisplay: 128
    dataDisplayForSubmitAnswer: 128
    stderrDisplay: 5120
eventReport:
  telegramBotToken: null
  telegramApiRoot: null
  sentTo: '@example'
  proxyUrl: null
vendor:
  ip2region: null
