{
  "compilerOptions": {
    "module": "nodenext",
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build"]
}
